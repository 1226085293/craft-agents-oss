#!/usr/bin/env sh
# Guard against accidentally committing temp/junk/residual paths.
# Keep patterns in sync with the ".gitignore Temp/residual guards" section.
# Note: no bare *.log pattern here on purpose — legitimate log fixtures or
# release logs exist in some projects; directory-level patterns below cover
# the accident class observed in this repo.
set -e

staged="$(git diff --cached --name-only --diff-filter=ACM)"
[ -z "$staged" ] && exit 0

# Single-line ERE (NO line-continuation backslashes — grep errors on them).
bad="$(printf '%s\n' "$staged" | grep -E '(^|/)~(^|/)|(^|/)AppData(^|/)|(^|/)[Tt]emp(^|/)|(^|/)tmp(^|/)|pending-plan-test-|sm-durability-|\.tmp$|\.temp$|\.bak$|\.orig$|\.rej$|\.swp$' || true)"

if [ -n "$bad" ]; then
  echo ""
  echo "🚫 检测到临时/残留文件被暂存，已阻止本次提交："
  printf '%s\n' "$bad" | sed 's/^/   - /'
  echo ""
  echo "处置建议："
  echo "  1) 临时文件 → git restore --staged <file> 移出暂存区，并加入 .gitignore"
  echo "  2) 确需提交 → git commit --no-verify 绕过（请谨慎）"
  echo ""
  exit 1
fi

exit 0
