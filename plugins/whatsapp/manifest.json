{
  "spec": "craft-plugin/1",
  "id": "whatsapp",
  "name": "WhatsApp",
  "version": "1.0.0",
  "description": "WhatsApp Business 会话。",
  "author": "Craft Agents",
  "actions": [
    {
      "name": "send_message",
      "description": "通过 WhatsApp 往指定会话发一条文本消息。channelId 来自事件来源（群为 group:<id>，私聊为 user:<id>）。",
      "input": {
        "type": "object",
        "properties": {
          "channelId": {
            "type": "string",
            "description": "目标频道：group:<id> 表示群，user:<id> 表示私聊。"
          },
          "text": {
            "type": "string",
            "description": "要发送的文本。过长时由平台侧截断。"
          }
        },
        "required": [
          "channelId",
          "text"
        ]
      }
    },
    {
      "name": "reply",
      "description": "用 WhatsApp 回复触发本次判断的那条消息。收件人由事件本身决定。",
      "repliesToOrigin": true,
      "input": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "回复内容。应简短：用户是在手机上看这条消息。"
          }
        },
        "required": [
          "text"
        ]
      }
    }
  ],
  "config": {
    "type": "object",
    "properties": {}
  },
  "icon": "message-circle",
  "setup": [
    {
      "text": "在插件右上角点「连接」后用手机 WhatsApp 扫描二维码配对。"
    }
  ],
  "commands": [
    {
      "name": "new",
      "description": "开一个新会话并绑定到这个聊天",
      "usage": "[name]"
    }
  ],
  "locales": "i18n",
  "runtime": {
    "kind": "script",
    "program": [
      "bun",
      "run",
      "program/serve.ts"
    ],
    "env": {
      "CRAFT_PLUGIN_ENTRY": "./program/index.ts"
    }
  }
}
