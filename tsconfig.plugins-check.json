{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "plugins/wechat/program/**/*.ts",
    "plugins/whatsapp/program/**/*.ts",
    "plugins/telegram/program/**/*.ts",
    "plugins/lark/program/**/*.ts",
    "plugins/qq/program/**/*.ts"
  ]
}
